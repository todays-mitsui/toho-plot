{
  "name": "toho-plot",
  "private": true,
  "version": "0.1.0",
  "description": "歩き旅ブログの記録地点と推定徒歩ルートを地図で表示する静的ビューア",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "update": "node src/generator/cli.ts update",
    "parse": "node src/generator/cli.ts parse",
    "routing:check": "node src/generator/cli.ts routing-check",
    "stage-data": "node scripts/stage-data.ts",
    "dev": "vite",
    "build": "node scripts/stage-data.ts && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "leaflet": "^1.9.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
